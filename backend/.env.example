# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database
# If missing, the app will fallback to data/db.json
DATABASE_URL=postgres://user:pass@localhost:5432/audmint

# AI Services
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# Email (SMTP)
EMAIL_FROM="AudMint" <no-reply@audmint.com>
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=your_smtp_password_or_api_key
